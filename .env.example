DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=django-insecure-dev-only-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://sparktal:sparktal@localhost:5432/sparktal
REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000
DEFAULT_FROM_EMAIL=Sparktal <no-reply@sparktal.com>
USE_S3=False
API_PORT=8001
CACHE_URL=redis://localhost:6379/1

# CV parsing with Claude: set both to turn it on, e.g. CV_PARSE_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
CV_PARSE_MODEL=
CV_PARSE_TIMEOUT_SECONDS=30

# Job description autofill on Create new job: uses ANTHROPIC_API_KEY above.
# Set a model to turn it on, e.g. JD_PARSE_MODEL=claude-sonnet-5-5; blank keeps it off.
JD_PARSE_MODEL=
JD_PARSE_TIMEOUT_SECONDS=90
