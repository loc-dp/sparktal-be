# Production settings for the API, worker and beat. Copy to .env.production and fill it in.
# .env.production is git-ignored and never goes into the image: Compose passes it in at run time.
# The host names below are placeholders; use your own domain.

DJANGO_SETTINGS_MODULE=config.settings.prod
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# The first entry is also what the container health check sends as its Host header.
DJANGO_ALLOWED_HOSTS=api.sparktal.com

# --- Database. Compose builds DATABASE_URL from these, so keep the password URL-safe:
# openssl rand -hex 24
POSTGRES_DB=sparktal
POSTGRES_USER=sparktal
POSTGRES_PASSWORD=

# --- Web app (the sparktal-fe deployment)
FRONTEND_URL=https://app.sparktal.com
# Where browsers send requests from: CORS, CSRF and the chat WebSocket check this list.
FRONTEND_ORIGINS=https://app.sparktal.com
# Parent domain of the app and the API, with the leading dot. Both session and CSRF cookies are
# set on it, so the app can read the CSRF token and forward the session. Leave unset only if
# the app and the API share one host.
COOKIE_DOMAIN=.sparktal.com

# --- Gunicorn
WEB_CONCURRENCY=3
# The reverse proxy reaches the API over a Docker network, and the port is bound to loopback.
FORWARDED_ALLOW_IPS=*
API_PORT=8000
# Turn on only if the reverse proxy does not already redirect HTTP to HTTPS.
SECURE_SSL_REDIRECT=False
# Starts at one year. Set 0 for the first deploys if you are not yet sure HTTPS works everywhere.
SECURE_HSTS_SECONDS=31536000

# --- File storage: S3 or any S3-compatible service (Cloudflare R2, MinIO, …). Required.
USE_S3=True
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Leave the endpoint out for AWS S3. For R2: https://<account-id>.r2.cloudflarestorage.com
# AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto

# --- Email (invites, password resets)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Sparktal <no-reply@sparktal.com>

# --- CV parsing and job description autofill with Claude. Blank models keep them off.
ANTHROPIC_API_KEY=
CV_PARSE_MODEL=claude-sonnet-5-5
CV_PARSE_TIMEOUT_SECONDS=30
JD_PARSE_MODEL=claude-sonnet-5-5
JD_PARSE_TIMEOUT_SECONDS=90

# --- Error reporting. Blank turns it off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
